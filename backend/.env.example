# ========================================================
# HyperStream — Configurações do Servidor e WebRTC STUN/TURN
# ========================================================

# Porta e Host do Servidor HTTP / WebSocket
PORT=3000
HOST=0.0.0.0

# Limite de Usuários por Sala (para proteger a banda de upload no P2P Mesh)
MAX_USERS_PER_ROOM=20

# ========================================================
# CONFIGURAÇÃO DE SERVIDORES ICE (STUN e TURN)
# ========================================================

# 1. Servidores STUN públicos (separados por vírgula)
# Utilizados para descobrir o IP público dos computadores na Internet (candidatos srflx)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# 2. Servidores TURN para Relay (Opcional, porém altamente recomendado para testar fora da rede local)
# Sem TURN, conexões entre participantes em 4G/5G ou roteadores com CGNAT/NAT Simétrico podem falhar.
#
# COMO OBTER UM TURN GRATUITO EM 1 MINUTO:
# 1. Crie uma conta gratuita em https://www.metered.ca/tools/openrelay/
# 2. Você ganha 50 GB de tráfego TURN gratuito por mês.
# 3. Preencha as variáveis abaixo com suas credenciais do painel:
#
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=seu_usuario_metered
# TURN_PASSWORD=sua_senha_metered

# Alternativa: caso o seu provedor de TURN forneça o array JSON pronto:
# ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:global.relay.metered.ca:443?transport=tcp"],"username":"xxx","credential":"yyy"}]
